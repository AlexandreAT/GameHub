# Desenvolvimento local: deixe sem alterar para usar o proxy /api do Vite.
# Produção no Netlify: use a URL pública do backend Render, incluindo /api.
# VITE_API_BASE_URL=https://seu-backend.onrender.com/api

# Opcional: permite testar o Vite contra a API HTTP executada pelo Docker.
# GAMEHUB_DEV_API_TARGET=http://127.0.0.1:8080
