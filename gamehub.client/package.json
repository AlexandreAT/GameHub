{
  "name": "gamehub.client",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "dev": "vite",
    "check:imports": "node scripts/check-import-case.mjs",
    "prebuild": "npm run check:imports",
    "build": "tsc && vite build",
